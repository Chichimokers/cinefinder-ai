# ============================================================
# CineFinder AI - Plantilla de configuración (VALORES FICTICIOS)
# ============================================================
# Copiar como referencia. NO introducir secretos reales aquí.
# El asistente scripts/setup_credentials.py escribe los valores
# reales en .env.local (ignorado por git).

# --- ADMINISTRACIÓN LOCAL (nunca en producción) ---
RENDER_API_KEY=rnd_TU_CLAVE_DE_ADMINISTRACION_LOCAL

# --- BASE DE DATOS ---
# Formato: postgresql://usuario:contraseña@host:puerto/base
SUPABASE_DATABASE_URL=postgresql://usuario:FICTICIO@db.ejemplo.supabase.co:5432/postgres

# --- NVIDIA NIM ---
NVIDIA_API_KEY=nvapi-TU_CLAVE_NVIDIA_FICTICIA
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- TELEGRAM (userbot) ---
TELEGRAM_API_ID=123456789
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_PHONE=+15550001111
TELEGRAM_OWNER_ID=123456789
# TELEGRAM_SESSION se genera tras la autenticación local. NO se pide.
TELEGRAM_SESSION=
TELEGRAM_CATALOG_CHANNEL_ID=

# --- PROVEEDORES OPCIONALES (dejar vacío para omitir) ---
TMDB_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
YOUTUBE_DATA_API_KEY=

# --- GENERADOS AUTOMÁTICAMENTE (no editar) ---
API_ACCESS_TOKEN=
SESSION_SECRET=
JOB_ENCRYPTION_KEY=

# --- AGENTE ---
AGENT_MAX_STEPS=8
AGENT_MAX_PARALLEL_TOOLS=4
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_CANDIDATES=10

# --- API ---
API_HOST=0.0.0.0
PORT=8000
RATE_LIMIT_PER_MINUTE=60
